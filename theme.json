{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Haut de page"
		},
		{
			"area": "header",
			"name": "header-fixed",
			"title": "Header fixe"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
                {
			"area": "uncategorized",
			"name": "card-bien",
			"title": "Card d'un bien"
		},
        {
			"area": "uncategorized",
			"name": "card",
			"title": "Card d'un post"
		},

        {
			"area": "uncategorized",
			"name": "query-loop-post",
			"title": "Boucle d'articles"
		},
        {
			"area": "uncategorized",
			"name": "query-loop-bien",
			"title": "Boucle de biens"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": ["page"],
			"title": "Page No Title"
		}
	],
    "blockTypes": {
        "core/cover": {
            "allowedBlocks": [
                "core/group",
                "core/columns",
                "core/paragraph",
                "core/heading",
                "core/buttons"
            ]
        }
    },
    "settings": {
        "custom": {
            "navigation": {
              "footer": "Footer Menu"
            }
        },
        "appearanceTools": true,
        "shadow": {
            "defaultPresets": false,
            "presets": [
              {
                "name": "Crisp",
                "slug": "crisp",
                "shadow": "6px 6px 0px 0px var(--wp--preset--color--accent)"
              },
              {
                "name": "Outlined",
                "slug": "outlined",
                "shadow": "0px 4px 40px 0px rgba(0, 0, 0, 0.20)"
              },
              {
                "name": "Outlined 2",
                "slug": "outlined 2",
                "shadow": "0px 2px 10px 0px rgba(31, 69, 96, 0.25)"
              }
            ]
          },
        "layout": {
            "contentSize": "960px",
            "wideSize": "1200px"
        },
        "color": {
         "duotone": [
                {
                    "colors": [  "#1744B0","#1C6DF4" ],
                    "slug": "bleu",
                    "name": "Bleu"
                },
                        {
                    "colors": [ "#1C6DF4","#1744B0" ],
                    "slug": "bleu-2",
                    "name": "Bleu 2"
                },
                                        {
                    "colors": [ "#000000","#1744B0" ],
                    "slug": "blanc-noir",
                    "name": "Blanc Noir"
                },
                {
                    "colors": [ "#000000","#1C6DF4" ],
                    "slug": "blanc-noir-2",
                    "name": "Blanc Noir 2"
                }
            ],
            "gradients": [
                {
					"slug": "gradient-1",
					"gradient": "linear-gradient(0deg, rgba(44, 45, 63, 0.00) 64.42%, var(--Gun-Powder-950, rgba(44, 45, 63, 0.70)) 87.02%);",
					"name": "Vertical Gris"
				}
            ],
            "palette": [
                {
                    "slug": "base",
                    "name": "Base",
                    "color": "#FFFFFF"
                },
                {
                    "slug": "base-2",
                    "name": "Base 2",
                    "color": "#F1804C"
                },
                {
                    "slug": "base-3",
                    "name": "Base 3",
                    "color": "#F5F6F9"
                },
                {
                    "slug": "base-4",
                    "name": "Base 4",
                    "color": "#1744B0"
                },
                {
                    "slug": "contrast",
                    "name": "Contrast",
                    "color": "#313135"
                },
                {
                    "slug": "contrast-2",
                    "name": "Contrast 2",
                    "color": "#1F1D49"
                },
                {
                    "slug": "contrast-3",
                    "name": "Contrast 3",
                    "color": "#27272A"
                },
                {
                    "slug": "accent",
                    "name": "Accent",
                    "color": "#F7997A"
                },
                {
                    "slug": "accent-2",
                    "name": "Accent-2",
                    "color": "#A9B7F8"
                },
                {
                    "slug": "accent-3",
                    "name": "Accent-3",
                    "color": "#000000"
                },
                {
                    "slug": "accent-4",
                    "name": "Accent-4",
                    "color": "#1C6DF4"
                },
                {
                    "slug": "transparent",
                    "name": "transparent",
                    "color": "transparent"
                },
                {
                    "slug": "currentColor",
                    "name": "currentColor",
                    "color": "currentColor"
                }
            ],
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false
        },
        "typography": {
            "writingMode": true,
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "var(--font-primary)",
                    "name": "Poppins",
                    "slug": "first"
                },
                {
                     "fontFamily": "var(--font-secondary)",
                    "name": "Anton",
                    "slug": "second"
                 
                }
            ],
          "fontSizes": [
            {
                "slug": "xs",
                "name": "s|15",
                "size": "0.938rem",
                "fluid": false
            },
            {
                "slug": "regular",
                "name": "regular|16",
                "size": "1rem",
                "fluid": false
            },
            {
                "slug": "s",
                "name": "s|18",
                "size": "clamp(1rem, 0.8481rem + 0.3165vw, 1.125rem);",
                "fluid": false
            },
            {
                "slug": "m",
                "name": "m|20",
                "size": "1.25rem",
                "fluid": false
            },
            {
                "slug": "l",
                "name": "l|21",
                "size": "1.313rem",
                "fluid": false
            },
            {
                "slug": "ll",
                "name": "ll|24",
                "size": "1.5rem",
                "fluid": false
            },
            {
                "slug": "xl",
                "name": "xl|64",
                "size": "clamp(3rem, 2.4444rem + 1.4815vw, 4rem);",
                "fluid": false
            },
            {
                "slug": "xxl",
                "name": "xxl|72",
                "size": "clamp(3rem, 2.1667rem + 2.6667vw, 4.5rem)",
                "fluid": false
            },
                        {
                "slug": "xxl-b",
                "name": "xxl-b|80",
                "size": "clamp(3rem, 1.8889rem + 3.5556vw, 5rem);",
                "fluid": false
            },
            {
                "slug": "xxxl",
                "name": "xxxl|120",
                "size": "clamp(3.5rem, 1.2778rem + 7.1111vw, 7.5rem);",
                "fluid": false
            }
        ]
        },
        "spacing": {
            "spacingSizes": [
                {
                    "slug": "1",
                    "name": ".5rem|8",
                    "size": ".5rem"
                },
                {
                    "slug": "2",
                    "name": "1rem|16",
                    "size": "1rem"
                },
                {
                    "slug": "3",
                    "name": "1.5rem|24",
                    "size": "1.5rem"
                },
                {
                    "slug": "4",
                    "name": "2rem|32",
                    "size": "2rem"
                },
                {
                    "slug": "5",
                    "name": "2.5rem|40",
                    "size": "2.5rem"
                },
                {
                    "slug": "6",
                    "name": "3rem|48",
                    "size": "3rem"
                },
                {
                    "slug": "60",
                    "name": "3.75rem|60",
                    "size": "3.75rem"
                },
                {
                    "slug": "7",
                    "name": "4.5rem|72",
                    "size": "4.5rem"
                },
                {
                    "slug": "8",
                    "name": "7.5rem|120",
                    "size": "7.5rem"
                },
                {
                    "slug": "9",
                    "name": "10rem|160",
                    "size": "10rem"
                },
                {
                    "slug": "10",
                    "name": "12.5rem|200",
                    "size": "12.5rem"
                },
                {
                    "slug": "11",
                    "name": "15rem|240",
                    "size": "15rem"
                },
                {
                    "slug": "12",
                    "name": "18.75rem|300",
                    "size": "18.75rem"
                },
                {
                    "slug": "headerheight",
                    "name": "header height",
                    "size": "var(--header-height)"
                },
                                {
                    "slug": "custom-01",
                    "name": "Custom 01",
                    "size": "var(--spacing-custom-01)"
                },
                                {
                    "slug": "custom-02",
                    "name": "Custom 02",
                    "size": "var(--spacing-custom-02)"
                },
                                {
                    "slug": "custom-03",
                    "name": "Custom 03",
                    "size": "var(--spacing-custom-03)"
                },
                                        {
                    "slug": "custom-04",
                    "name": "Custom 04",
                    "size": "var(--spacing-custom-04)"
                }
            ],
            "defaultSpacingSizes": false,
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        }
    },
    "styles": {
        "css": "background: var(--wp--preset--color--base); where(.wp-site-blocks) > * { margin-block-start: 0 !important; margin-block-end: 0 !important; } ",
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--first)"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)"
                }
            }
        },
        "blocks": {
            "core/heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)",
                    "fontSize" :"var(--wp--preset--font-size--xxl)",
                    "lineHeight": "1.25",
                    "fontWeight":"400"
                }
            },
            "core/paragraph":{
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--s)",
                    "lineHeight" : "1.4"
                }
            },
            "core/quote": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-four)",
                    "fontWeight" :"600",
                    "lineHeight": "1.15",
                    "textAlign": "center",
                    "fontStyle" : "italic"
                },
                 "css": "text-wrap:pretty;"
            },
            "core/list-item": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--s)",
                    "lineHeight" : "1.25"
                },
                "spacing": {
                "margin": {
                    "bottom": "var:preset|spacing|1"
                    }
                }
            },
            "core/separator":{
                "css": "height:1px; border-top: 0; margin-block-start: 0 !important;",
                       "spacing": {
                    "blockGap" :"0"
                }
            },
            "core/spacer":{
                "css": "margin-block-start: 0 !important;",
                "spacing": {
                    "blockGap" :"0"
                }
            },
                        "core/query-pagination": {
 "css":"color:var(--wp--preset--color--base-2); font-weight:bold; text-decoration:none",
                "elements": {
                   
                    "link": {
                            "spacing": {
                            "padding": {
                                "top": ".1em",
                                "bottom": ".1em",
                                "left": ".1em",
                                "right": ".1em"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--base-4)"
                        },
               
                        "typography": {
                            "fontSize": "1rem"
                        },
                        ":hover" :{
                            "color": {
                                "text": "var(--wp--preset--color--base-2)"
                            }
                        }
                    }
             
                },
                "spacing": {
                    "margin": {
                        "top": "2rem"
                    }
                }
            },
            "core/query-pagination-numbers": {
                "elements": {
                    "link": {
                        "spacing": {
                            "padding": {
                                "top": ".1em",
                                "bottom": ".1em",
                                "left": ".1em",
                                "right": ".1em"
                            }
                        },
                        "typography": {
                            "textDecoration" :"none"
                        },
                        "color": {
                            "text": "var(--wp--preset--color--base-4)",
                            "background": "transparent"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--base-4)"
                            }
                        }
                    }
                }
            },
            "core/query-pagination-previous": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "inherit"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                }
            },
            "core/query-pagination-next": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "inherit"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                }
            },
            "core/button": {
                "css" : "transition:all .4s",
                "border":{
                    "radius": "0",
                    "color": "var(--wp--preset--color--accent)",
                    "width": "2px",
                    "style": "solid"
                },
                "color": {
                    "text": "currentColor",
                    "background": "var(--wp--preset--color--accent)"
                },
                "typography": {
                    "textTransform": "none",
                    "fontSize": "var(--wp--preset--font-size--regular)",
                    "fontWeight": "600",
                    "lineHeight" :"1.4"
                },
                "spacing": {
                    
                            "padding": {
                                "bottom": ".5rem",
                                "left": "1rem",
                                "right": ".75rem",
                                "top": ".5rem"
                            }
                        },
                "variations": {
                    "outline": {
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--accent)"
                        },
                        "border": {
                            "color": "currentColor"
                        },
                        "typography": {
                            "textTransform": "none",
                            "fontSize": "var(--wp--preset--font-size--regular)",
                            "fontWeight": "600"
                        }
                    }
                }
            }
        }
    }
}