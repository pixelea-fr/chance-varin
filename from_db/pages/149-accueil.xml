<div class="wp-block-button is-style-core-button-with-arrows-no-border is-style-with-arrows-no-border"><a class="wp-block-button__link wp-element-button" href="/genre/vente/">Nos ventes</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:paragraph -->
