{
    "$schema": "https:\/\/schemas.wp.org\/trunk\/theme.json",
    "version": 3,
    "slug": "style5",
    "title": "style5",
    "blockTypes": [
        "core\/group",
        "core\/columns",
        "core\/column",
        "core\/cover"
    ],
    "styles": {
        "color": {
            "background": "transparent",
            "text": "var(--wp--preset--color--base)"
        },
        "blocks": {
            "core/button":{
                "color": {
                    "background": "transparent",
                    "text": "var(--wp--preset--color--base)"
                },
                "border": {
                    "color": "currentColor"
                }
            }
        },
        "elements": {
            "button": {
                ":hover":{
                    "color": {
                        "background": "var(--wp--preset--color--base-4) !important",
                        "text": "var(--wp--preset--color--base) !important"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--base-4) !important"
                    }
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--base)"
                }
            },
            "link":{
                "color": {
                    "text": "red"
                },
                ":hover":{
                    "color": {
                        "text": "red)"
                    }
                },
                "typography": {
                    "textDecoration": "none"
                  }
            }
        }
    }
}